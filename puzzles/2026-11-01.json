 "clues": {
  "across": [
   {
    "number": 1,
    "text": "\u0007Þótt ég panti næstum því stóra stærð af Ópal fæ ég bara dýr í staðinn",
    "enumeration": "8",
    "answer_length": 8,
    "row": 0,
    "col": 0
   },
   {
    "number": 5,
    "text": "\u0007Stór íslensk tunna kemur næsta dag til eins sem er fagurkeri.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 0,
    "col": 9
   },
   {
    "number": 10,
    "text": "\u0007Meðal og lítið grýtt svæði eru fyrir þau mökuð í feiti.",
    "enumeration": "5",
    "answer_length": 5,
    "row": 2,
    "col": 0
   },
   {
    "number": 11,
    "text": "\u0007Ó, fyrir dauða sinn er hún eins og hún sé einþykk.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 2,
    "col": 7
   },
   {
    "number": 12,
    "text": "\u0007Kalkúnn inniheldur steinefni.",
    "enumeration": "4",
    "answer_length": 4,
    "row": 3,
    "col": 4
   },
   {
    "number": 13,
    "text": "\u0007Gömul í ástum fær sér ávöxt.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 5,
    "col": 0
   },
   {
    "number": 15,
    "text": "\u0007Ég sýni áreiðanlegu samt skilning.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 5,
    "col": 11
   },
   {
    "number": 16,
    "text": "\u0007Fresti með Knattspyrnufélagi Akureyrar að hitta þann ákafasta.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 7,
    "col": 0
   },
   {
    "number": 18,
    "text": "\u0007Ná matskeið og fá ost að norðan áður en strípuð útgjöld birtast.",
    "enumeration": "13",
    "answer_length": 13,
    "row": 8,
    "col": 7
   },
   {
    "number": 20,
    "text": "\u0007Athugið! Róið skotspóninn.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 10,
    "col": 1
   },
   {
    "number": 21,
    "text": "\u0007Ríkur maður drepur. Það er ekki óhóf.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 10
   },
   {
    "number": 25,
    "text": "\u0007Kríp kemur í sal úr eik til að sjá að Ari er orðinn listamaður.",
    "enumeration": "13",
    "answer_length": 13,
    "row": 12,
    "col": 0
   },
   {
    "number": 28,
    "text": "\u0007Bít úr súblímati og gef dýri.",
    "enumeration": "6",
    "answer_length": 6,
    "row": 12,
    "col": 14
   },
   {
    "number": 29,
    "text": "\u0007Gljúpleikinn í viðnum kemur upphaflega fram í janúar sökum Freys.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 14,
    "col": 0
   },
   {
    "number": 31,
    "text": "\u0007Sneggra kemur að sprænu drengs.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 14,
    "col": 12
   },
   {
    "number": 32,
    "text": "\u0007Sé flesta ferma.",
    "enumeration": "5",
    "answer_length": 5,
    "row": 15,
    "col": 8
   },
   {
    "number": 33,
    "text": "\u0007Frú Hansa ruglast á byggingargerð.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 16,
    "col": 12
   },
   {
    "number": 34,
    "text": "\u0007En undrunaróp er yfir því að sígaretta sé gerð úr skordýri.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 17,
    "col": 0
   },
   {
    "number": 35,
    "text": "\u0007Teiknið merki í tungumálinu.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 19,
    "col": 0
   },
   {
    "number": 36,
    "text": "\u0007Í ruglinu orgaðir þú: „Sef hjá matsveini“.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 19,
    "col": 10
   }
  ],
  "down": [
   {
    "number": 1,
    "text": "\u0007Af Sjúkrahúsinu á Akureyri kemur huldumaður sem reynist vera galgopi.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 0,
    "col": 0
   },
   {
    "number": 2,
    "text": "\u0007Við gat á klæði trekkir þú einhvern veginn stressað að.",
    "enumeration": "13",
    "answer_length": 13,
    "row": 0,
    "col": 2
   },
   {
    "number": 3,
    "text": "\u0007Lýk einhvern veginn við orð um skepnu.",
    "enumeration": "6",
    "answer_length": 6,
    "row": 0,
    "col": 4
   },
   {
    "number": 4,
    "text": "\u0007Vakna hjá einhvers konar ódói og fá ávextina fyrir það.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 0,
    "col": 7
   },
   {
    "number": 5,
    "text": "\u0007Lausn á snjó?",
    "enumeration": "7",
    "answer_length": 7,
    "row": 0,
    "col": 9
   },
   {
    "number": 6,
    "text": "\u0007Viss lakki einhvern veginn þrátt fyrir blekkingu.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 0,
    "col": 11
   },
   {
    "number": 7,
    "text": "\u0007Muldraði: „Örkumlaðir“.",
    "enumeration": "6",
    "answer_length": 6,
    "row": 0,
    "col": 13
   },
   {
    "number": 8,
    "text": "\u0007Íslensk gylta sem aska umlykur talar fornt tungumál",
    "enumeration": "9",
    "answer_length": 9,
    "row": 0,
    "col": 16
   },
   {
    "number": 9,
    "text": "\u0007Það dimmdi næstum þegar ég fékk mér drykk og stóran hluta af kruðu á meðan þið fögnuðuð.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 0,
    "col": 18
   },
   {
    "number": 14,
    "text": "\u0007Markaðshæfur tapar hurð við að skemma hana.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 5,
    "col": 5
   },
   {
    "number": 17,
    "text": "\u0007Munnur í Ópinu er á óhefluðum manni",
    "enumeration": "13",
    "answer_length": 13,
    "row": 7,
    "col": 14
   },
   {
    "number": 19,
    "text": "\u0007Einhleypur aðili sem enginn nær í",
    "enumeration": "12",
    "answer_length": 12,
    "row": 8,
    "col": 10
   },
   {
    "number": 22,
    "text": "\u0007Grípið keppni og dótið.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 12
   },
   {
    "number": 23,
    "text": "\u0007Með öxi og stera fór hann aftur á hreyfingu, enda var hann til.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 16
   },
   {
    "number": 24,
    "text": "\u0007Væri Tarsan án flýtis í kór, syngi hann um fótabúnað.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 19
   },
   {
    "number": 25,
    "text": "\u0007Þú sast með frægri bandarískri dansmynd af því að hún var mest djúsí.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 12,
    "col": 0
   },
   {
    "number": 26,
    "text": "\u0007Óþekktur er í korni og er kankvís.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 12,
    "col": 3
   },
   {
    "number": 27,
    "text": "\u0007Fylli út innan ramma í heimsókninni.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 12,
    "col": 8
   },
   {
    "number": 30,
    "text": "\u0007Áhaldakaup sem Alda er ekki hluti af þrátt fyrir að vera launahá.",
    "enumeration": "6",
    "answer_length": 6,
    "row": 14,
    "col": 5
   }
  ]
 }
}
