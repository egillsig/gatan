 "clues": {
  "across": [
   {
    "number": 1,
    "text": "Hafa í raun Dani og Flæmingi næstum forðast að segja sannleikann?",
    "enumeration": "9,1,8",
    "answer_length": 18,
    "row": 0,
    "col": 0
   },
   {
    "number": 8,
    "text": "Sér Ken konu Simba sem ruglaða t***u sem er almennust í útliti.",
    "enumeration": "15",
    "answer_length": 15,
    "row": 2,
    "col": 0
   },
   {
    "number": 10,
    "text": "Það er aðeins hismi sem felur stefnu.",
    "enumeration": "4",
    "answer_length": 4,
    "row": 2,
    "col": 16
   },
   {
    "number": 12,
    "text": "Kaupfari úr arfaskiptabréfum fylgir annað opinbert plagg.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 4,
    "col": 0
   },
   {
    "number": 13,
    "text": "Tréleikfang með bandi í stað lims.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 4,
    "col": 9
   },
   {
    "number": 14,
    "text": "Útlagi fær íslenska endingu á hæfileikum og peningum hjá forlaginu.",
    "enumeration": "13",
    "answer_length": 13,
    "row": 6,
    "col": 0
   },
   {
    "number": 15,
    "text": "Sérstakur framburður sem heyrist enn ef júní er úrkomulaus.",
    "enumeration": "6",
    "answer_length": 6,
    "row": 6,
    "col": 14
   },
   {
    "number": 16,
    "text": "Slöngusnakkið er fyrir þá sem hefur skaddast af dýri.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 8,
    "col": 0
   },
   {
    "number": 17,
    "text": "Er fön, gullin, nær króknum?",
    "enumeration": "9",
    "answer_length": 9,
    "row": 8,
    "col": 11
   },
   {
    "number": 19,
    "text": "Með Honda S er ég kominn með úr frá þessu landi.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 10,
    "col": 1
   },
   {
    "number": 23,
    "text": "Leist Óttari vel á þær með hvíta fætur.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 10
   },
   {
    "number": 29,
    "text": "Platar annan inn í verslun sem reynist vera íverustaður.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 13,
    "col": 0
   },
   {
    "number": 30,
    "text": "Ógn Vals er að guðlegt ökutæki gæti fundist.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 13,
    "col": 13
   },
   {
    "number": 32,
    "text": "Oj, þarf bara fimm grömm til að við getum átt möguleika.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 15,
    "col": 10
   },
   {
    "number": 33,
    "text": "Íslensk stofnun er í Kína vegna sníkjudýrs.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 17,
    "col": 0
   },
   {
    "number": 34,
    "text": "Beygja í þýskum dansi og gosdrykkur sem er hægt að ná með lærdómi.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 17,
    "col": 8
   },
   {
    "number": 35,
    "text": "Rómverskt virki í Þýskalandi með það sem er í lagi einu sinni enn og reynist vera borðbúnaðurinn.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 19,
    "col": 0
   },
   {
    "number": 36,
    "text": "Á krílið plastefnið? Já, en bara ranglega.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 19,
    "col": 13
   }
  ],
  "down": [
   {
    "number": 1,
    "text": "Borða ekki með belju sem reynist vera viðskiptavinur.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 0,
    "col": 0
   },
   {
    "number": 2,
    "text": "Það er verkefni utan eðlilegs tímabils að fremja fleiri fjöldamorð.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 0,
    "col": 3
   },
   {
    "number": 3,
    "text": "Helstu tíðindi eru það sem Alf er gefið.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 0,
    "col": 7
   },
   {
    "number": 4,
    "text": "Í tal skal færa þetta tungumál.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 0,
    "col": 9
   },
   {
    "number": 5,
    "text": "Gerum Eið og einn enskan brjálaðan af því að við erum skemmandi mannorði þeirra.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 0,
    "col": 12
   },
   {
    "number": 6,
    "text": "Skipta um LAN en til þess þarf auðkenninguna.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 0,
    "col": 14
   },
   {
    "number": 7,
    "text": "Með gullstaf úr eik verður það hrætt.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 0,
    "col": 16
   },
   {
    "number": 9,
    "text": "Búðarlokurnar bera engan kala til þessa svæðis í Kaupmannahöfn.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 2,
    "col": 5
   },
   {
    "number": 11,
    "text": "Mamma Gunnhildur sést í Danmörku árdegis.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 2,
    "col": 18
   },
   {
    "number": 18,
    "text": "Í signor með rænu er aðeins hægt að ná á miðvikudaginn á undan lærdómnum.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 8,
    "col": 19
   },
   {
    "number": 20,
    "text": "Otto gleymir ekki íslenskum peningi sem hann fær fyrir austurlenska.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 2
   },
   {
    "number": 21,
    "text": "Dálítið drukkin nær að verða bein. Það er skynsamlegast.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 6
   },
   {
    "number": 22,
    "text": "Dálítið nöldur yfir kindaafurð í pakka.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 8
   },
   {
    "number": 23,
    "text": "Þreytt á vegi.",
    "enumeration": "4",
    "answer_length": 4,
    "row": 10,
    "col": 10
   },
   {
    "number": 24,
    "text": "Fugl sem hlær við sólu.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 13
   },
   {
    "number": 25,
    "text": "Æi, mig langar í slot frá hlutlausum.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 15
   },
   {
    "number": 26,
    "text": "Glúrnar hafa vit á því að skapa sér rugl út af guði.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 17
   },
   {
    "number": 27,
    "text": "Rekadrumb reytum og umbyltum.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 11,
    "col": 0
   },
   {
    "number": 28,
    "text": "Hún Ína okkar spilar á blásturshljóðfæri.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 12,
    "col": 4
   },
   {
    "number": 31,
    "text": "Meðalstóri marijúanavindlingurinn er fyrir grönnu konuna.",
    "enumeration": "6",
    "answer_length": 6,
    "row": 14,
    "col": 11
   }
  ]
 },
