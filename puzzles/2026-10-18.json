 "clues": {
  "across": [
   {
    "number": 1,
    "text": "\u0007Það eru eftirköst af því að taka einhvern af vegferð sinni.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 0,
    "col": 0
   },
   {
    "number": 5,
    "text": "\u0007Næ að hlæja við feni í fangelsi.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 0,
    "col": 12
   },
   {
    "number": 9,
    "text": "\u0007HL-stöðin og Bifreiðar og landbúnaðarvélar fá tómt svæði sem er vott.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 2,
    "col": 0
   },
   {
    "number": 11,
    "text": "\u0007Set læk við N1 og sé hvar haf og gróðurblettur einkenna starfstímabilið.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 3,
    "col": 10
   },
   {
    "number": 12,
    "text": "\u0007Dekri eðli með einu stærðfræðitákninu.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 5,
    "col": 0
   },
   {
    "number": 13,
    "text": "\u0007Höldum á erlendri sultu þegar við tökum þátt í skátamóti.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 5,
    "col": 12
   },
   {
    "number": 14,
    "text": "\u0007Dast við tunnuna og þá varð unaðstími.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 7,
    "col": 0
   },
   {
    "number": 17,
    "text": "\u0007 Er vinstrisinnuð í knattspyrnuliði með sérstakan háralit?",
    "enumeration": "6",
    "answer_length": 6,
    "row": 7,
    "col": 12
   },
   {
    "number": 18,
    "text": "\u0007Þúsund júl eru aftar ef ég er að spjalla um þau.",
    "enumeration": "6",
    "answer_length": 6,
    "row": 9,
    "col": 8
   },
   {
    "number": 20,
    "text": "\u0007Hrakfallabálkur lendir í eldi.",
    "enumeration": "3",
    "answer_length": 3,
    "row": 9,
    "col": 17
   },
   {
    "number": 21,
    "text": "\u0007Henda stól og steypa.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 10,
    "col": 0
   },
   {
    "number": 24,
    "text": "\u0007Auðkenni undina á athyglisverða tímabilinu.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 11,
    "col": 10
   },
   {
    "number": 26,
    "text": "\u0007Þeir og Atli eru með einhvers konar matarstell.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 12,
    "col": 0
   },
   {
    "number": 27,
    "text": "\u0007Lætur úldna aftur í vinstrisækni.",
    "enumeration": "5",
    "answer_length": 5,
    "row": 13,
    "col": 6
   },
   {
    "number": 29,
    "text": "\u0007Fæ stóran miða frá erlendum leikstjóra á fornu tímabili.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 13,
    "col": 12
   },
   {
    "number": 32,
    "text": "\u0007Turnar sem Viktor fer fram hjá til að sjá rassana.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 15,
    "col": 0
   },
   {
    "number": 34,
    "text": "\u0007Í maí verður Skúli stopp að einhverju leyti í vitleysu sinni yfir retórík.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 15,
    "col": 10
   },
   {
    "number": 35,
    "text": "\u0007Peningur sem fer í hjákonu reynist vera það sem fer í endurnýjun.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 17,
    "col": 0
   },
   {
    "number": 36,
    "text": "\u0007Finn til leiða við að kynna eitthvað nýtt.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 17,
    "col": 12
   },
   {
    "number": 37,
    "text": "\u0007Kurteisir tæla þig enda hárfagrir.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 19,
    "col": 0
   },
   {
    "number": 38,
    "text": "\u0007Afhendi ranglega. Það er ójöfnuður.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 19,
    "col": 12
   }
  ],
  "down": [
   {
    "number": 1,
    "text": "\u0007Að kasta af sér skilum.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 0,
    "col": 0
   },
   {
    "number": 2,
    "text": "\u0007Þótt ég slíti dúk í tveimur stórum stæðum má samt sjá að hann var þunnur.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 0,
    "col": 3
   },
   {
    "number": 3,
    "text": "\u0007Bjalla á Stöng er frægt handverk úr Svartaskógi.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 0,
    "col": 8
   },
   {
    "number": 4,
    "text": "\u0007Fiktið við hóp sem er í góðri þjálfun.",
    "enumeration": "6",
    "answer_length": 6,
    "row": 0,
    "col": 10
   },
   {
    "number": 5,
    "text": "\u0007Sænskt dýr kemur með rykk næstum út úr fyllibyttu.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 0,
    "col": 12
   },
   {
    "number": 6,
    "text": "\u0007Fyrsta konan eftir heimsendi sá verslun og hóf þar langa búsetu.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 0,
    "col": 15
   },
   {
    "number": 7,
    "text": "\u0007Sjá! Var greiða á malarhrygg?",
    "enumeration": "12",
    "answer_length": 12,
    "row": 0,
    "col": 17
   },
   {
    "number": 8,
    "text": "\u0007Miðlungs Yrsa getur fjallað um kremið.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 0,
    "col": 19
   },
   {
    "number": 10,
    "text": "\u0007Svívirða það að blanda, amma.",
    "enumeration": "6",
    "answer_length": 6,
    "row": 2,
    "col": 5
   },
   {
    "number": 15,
    "text": "\u0007Drekkur enn ponsu og verður harðnaður að utan.",
    "enumeration": "13",
    "answer_length": 13,
    "row": 7,
    "col": 6
   },
   {
    "number": 16,
    "text": "\u0007Gulllæknir er eiginmaður draugs og skýjaglópur.",
    "enumeration": "13",
    "answer_length": 13,
    "row": 7,
    "col": 10
   },
   {
    "number": 19,
    "text": "\u0007Skíðaguð með hálfþokkalegan staf er syndugur.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 9,
    "col": 15
   },
   {
    "number": 22,
    "text": "\u0007Í leið að listatímabilinu sést Kári.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 10,
    "col": 2
   },
   {
    "number": 23,
    "text": "\u0007Vefjarþræðir pressaðir saman sýna afl.",
    "enumeration": "4",
    "answer_length": 4,
    "row": 10,
    "col": 4
   },
   {
    "number": 25,
    "text": "\u0007Þótt lifandi svamli er það samt í feni.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 11,
    "col": 13
   },
   {
    "number": 26,
    "text": "\u0007Kýs framboð og gerir það frábærlega.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 12,
    "col": 0
   },
   {
    "number": 28,
    "text": "\u0007Var svo kallið rofið með íslaginu.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 13,
    "col": 8
   },
   {
    "number": 30,
    "text": "\u0007Mýkist við að fimm hundruð hafa ekki gist hjá mér.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 13,
    "col": 17
   },
   {
    "number": 31,
    "text": "\u0007Sá Rút hjá skít þegar ég ruddi til.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 13,
    "col": 19
   },
   {
    "number": 33,
    "text": "\u0007Öskulagafræði hefur ákveðið form.",
    "enumeration": "1-4",
    "answer_length": 5,
    "row": 15,
    "col": 4
   }
  ]
 }
}
