 "clues": {
  "across": [
   {
    "number": 1,
    "text": "\u0007Kynlíf fugls er okkur nauðsynlegt.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 0,
    "col": 0
   },
   {
    "number": 5,
    "text": "\u0007Sver fallega að hann muni slípa.",
    "enumeration": "6",
    "answer_length": 6,
    "row": 0,
    "col": 14
   },
   {
    "number": 8,
    "text": "\u0007Slyngur fær eitt gramm til að einfalda sér að finna afkvæmi.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 2,
    "col": 9
   },
   {
    "number": 10,
    "text": "\u0007Sá hluti heilans sem er undir fínum sætum.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 3,
    "col": 0
   },
   {
    "number": 12,
    "text": "\u0007Drykkirnir, kassettan og ullarvinnslutólið.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 4,
    "col": 9
   },
   {
    "number": 13,
    "text": "\u0007Leyfi fimmtíu að gista hjá mér í staðinn fyrir stóra menn. Í staðinn fæ ég það sem sníkjudýr nýtir sér",
    "enumeration": "10",
    "answer_length": 10,
    "row": 5,
    "col": 0
   },
   {
    "number": 14,
    "text": "\u0007Fúll yfirgefur fjallshnúk út af slæmri meðferð.",
    "enumeration": "6",
    "answer_length": 6,
    "row": 6,
    "col": 13
   },
   {
    "number": 15,
    "text": "\u0007Hann fyllir út í litabók en er á hreyfingu. Það er yfirbragð málningar.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 8,
    "col": 0
   },
   {
    "number": 17,
    "text": "\u0007Varpi birtu á einfaldan al, snæðing og sérstakan dunk.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 8,
    "col": 11
   },
   {
    "number": 22,
    "text": "\u0007Gullkaleikar fá á sig ryk frá listamönnum.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 10,
    "col": 0
   },
   {
    "number": 24,
    "text": "\u0007Dinglist smá þegar kast færir okkur samtals 507.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 11,
    "col": 12
   },
   {
    "number": 25,
    "text": "\u0007Sá sem er vók í AA dó út af ávexti.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 12,
    "col": 0
   },
   {
    "number": 28,
    "text": "\u0007Ég heillast ranglega af arfi sem er með í hugsun.",
    "enumeration": "14",
    "answer_length": 14,
    "row": 13,
    "col": 6
   },
   {
    "number": 31,
    "text": "\u0007Drekkur við þessa á á Austurlandi.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 14,
    "col": 0
   },
   {
    "number": 32,
    "text": "\u0007Hafna vegna einhvers konar teina.",
    "enumeration": "5",
    "answer_length": 5,
    "row": 15,
    "col": 15
   },
   {
    "number": 33,
    "text": "\u0007Þótt óþekktur sigli hratt að nesi er samt tonn með í kaffipásunni.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 16,
    "col": 0
   },
   {
    "number": 34,
    "text": "\u0007Signý fær plan sem reynist bara vera falsvonin.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 17,
    "col": 11
   },
   {
    "number": 35,
    "text": "\u0007Hjartaáfall af bræði er mikið áfall.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 19,
    "col": 0
   },
   {
    "number": 36,
    "text": "\u0007Binda sig við aðdáunarhreima.",
    "enumeration": "5",
    "answer_length": 5,
    "row": 19,
    "col": 11
   }
  ],
  "down": [
   {
    "number": 1,
    "text": "\u0007Ég sé slot aftur enda skökk.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 0,
    "col": 0
   },
   {
    "number": 2,
    "text": "\u0007Óvitlausar fara í kaf fyrir einn í sérstöku boði.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 0,
    "col": 6
   },
   {
    "number": 3,
    "text": "\u0007Búsetugata þar sem lið sýnir magnið.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 0,
    "col": 9
   },
   {
    "number": 4,
    "text": "\u0007Ég flyt ílát á sérstakan hátt, enda eru þau full af tilfinningum.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 0,
    "col": 11
   },
   {
    "number": 5,
    "text": "\u0007Spurning fyrir spyrjanda sem er búandi til band.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 0,
    "col": 14
   },
   {
    "number": 6,
    "text": "\u0007Irma í Félagsstofnun stúdenta fer á bar til að skoða fyrirtækjalista.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 0,
    "col": 18
   },
   {
    "number": 7,
    "text": "\u0007Há fær kindur og kuldatilfinningu.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 2,
    "col": 4
   },
   {
    "number": 9,
    "text": "\u0007Ella sér g-lykil, enda er hún skutla.",
    "enumeration": "5",
    "answer_length": 5,
    "row": 2,
    "col": 16
   },
   {
    "number": 11,
    "text": "\u0007Tek prinsessuskó með á dansleik.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 3,
    "col": 2
   },
   {
    "number": 16,
    "text": "\u0007Bensó hér og bensó þar.",
    "enumeration": "6",
    "answer_length": 6,
    "row": 8,
    "col": 8
   },
   {
    "number": 18,
    "text": "\u0007Þótt ég hálfvegis flatmagi í landsbyggðarkyrrð er þurfalingur ekki langt undan.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 8,
    "col": 13
   },
   {
    "number": 19,
    "text": "\u0007Norrænt ritmál veldur tafsamri meðferð skjala.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 8,
    "col": 15
   },
   {
    "number": 20,
    "text": "\u0007Bæta rándýrin lögfræðingana?",
    "enumeration": "12",
    "answer_length": 12,
    "row": 8,
    "col": 17
   },
   {
    "number": 21,
    "text": "\u0007Takt sem Einar sýnir enn er einstök í lok október og snýst um glóandi stangirnar.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 8,
    "col": 19
   },
   {
    "number": 22,
    "text": "\u0007Lamast undir erfiðum tímabilum.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 0
   },
   {
    "number": 23,
    "text": "\u0007Bætið hálfa Kahlúa. Þetta er svívirðilega framkoman.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 10,
    "col": 4
   },
   {
    "number": 26,
    "text": "\u0007Hrósið sem einn fyrir dónaskap.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 12,
    "col": 2
   },
   {
    "number": 27,
    "text": "\u0007Hávært óp hjá tryggingarfélagi lýsir þeim dónalega.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 12,
    "col": 6
   },
   {
    "number": 29,
    "text": "\u0007Stansi og yfirgefi í tilgangsleysi. Þetta er ekki sennileg frásögn.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 13,
    "col": 9
   },
   {
    "number": 30,
    "text": "\u0007Sleppa við sorg út af óformlegu orðfæri.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 13,
    "col": 11
   }
  ]
 }
}
