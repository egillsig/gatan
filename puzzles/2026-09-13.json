 "clues": {
  "across": [
   {
    "number": 1,
    "text": "Fran skarkar og fær töflur og óhollan mat.",
    "enumeration": "8,9",
    "answer_length": 17,
    "row": 0,
    "col": 0
   },
   {
    "number": 11,
    "text": "Já, spænskur er sérhver hálffullur og hann hittir þá sem breytist alltaf.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 2,
    "col": 0
   },
   {
    "number": 12,
    "text": "Tek skinnið af enskri ungfrú. Við það tóri ég næstum, enda er ég mikil.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 2,
    "col": 10
   },
   {
    "number": 13,
    "text": "Við einfaldaða ógn sænskrar hljómsveitar fær Ernir að mestu graftarbólurnar.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 4,
    "col": 8
   },
   {
    "number": 14,
    "text": "Ég næ að ösla með hreinan kúk og kem ekki að hrúgu úr gosefnum.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 5,
    "col": 0
   },
   {
    "number": 15,
    "text": "Eðallúr skilar okkur aftur vafningi.",
    "enumeration": "5",
    "answer_length": 5,
    "row": 6,
    "col": 8
   },
   {
    "number": 16,
    "text": "Fer aftur í heimsókn til óþekkts eins.",
    "enumeration": "6",
    "answer_length": 6,
    "row": 6,
    "col": 14
   },
   {
    "number": 17,
    "text": "Skap Ingva getur breyst út af báti.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 7,
    "col": 0
   },
   {
    "number": 18,
    "text": "Aldrei er það falin diskaþurrka sem hefur að geyma band.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 8,
    "col": 10
   },
   {
    "number": 20,
    "text": "Æ, á undan því sá ég að enn einn sýnir frekju.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 10,
    "col": 0
   },
   {
    "number": 26,
    "text": "Auli hjá Tennis- og badmintonfélagi Reykjavíkur fær næstum þúsund á mikla litasýningu.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 10,
    "col": 13
   },
   {
    "number": 28,
    "text": "Hvað er þetta? Teskeið lafir með úrani sem er fengið frá líkamshlutum dýra.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 12,
    "col": 0
   },
   {
    "number": 29,
    "text": "Ég á einhvern veginn arfinn þótt þú gefir hann.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 12,
    "col": 13
   },
   {
    "number": 31,
    "text": "Fer með Ellu í sömbutíma þrátt fyrir að vera kvartsár.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 14,
    "col": 0
   },
   {
    "number": 32,
    "text": "Afslöppuð vari kóng við rofa.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 14,
    "col": 11
   },
   {
    "number": 33,
    "text": "Nær að láta aftur stóran ost sem freistingu.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 16,
    "col": 0
   },
   {
    "number": 34,
    "text": "Fimm gubba eftir mat og ég sá eftirgrennslan eftir fæðu.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 16,
    "col": 9
   },
   {
    "number": 35,
    "text": "Var útdautt spendýr með fitugt hár?",
    "enumeration": "6",
    "answer_length": 6,
    "row": 18,
    "col": 0
   },
   {
    "number": 36,
    "text": "Hreinleikinn er einn að þvælast í aflverkinu fyrir gagnaútreikning.",
    "enumeration": "13",
    "answer_length": 13,
    "row": 19,
    "col": 7
   }
  ],
  "down": [
   {
    "number": 1,
    "text": "Er smá ögn orðin skylda sex? Já, með líkamshluta dýrs.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 0,
    "col": 0
   },
   {
    "number": 2,
    "text": "Ég sé reyk fara um grashaf og rugla aumingja.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 0,
    "col": 2
   },
   {
    "number": 3,
    "text": "Tek Emmu frá merkjasteininum til að skýra fyrir henni jarðfræðihugtak.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 0,
    "col": 4
   },
   {
    "number": 4,
    "text": "Ég vil einhvern veginn fleiri kristala í heimtingu minni til dánarbús.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 0,
    "col": 6
   },
   {
    "number": 5,
    "text": "Annað heiti yfir keiluspilara? Nei, frjálsíþróttamaður.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 0,
    "col": 8
   },
   {
    "number": 6,
    "text": "Landgreifar geta lent í veiðitækinu.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 0,
    "col": 10
   },
   {
    "number": 7,
    "text": "Þau sem eru fljótfær þjálfa sig fyrir eina ferð með ferðamanni.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 0,
    "col": 12
   },
   {
    "number": 8,
    "text": "Eldstæði sem beinn vegur liggur að, eða svo segir fræðarinn.",
    "enumeration": "13",
    "answer_length": 13,
    "row": 0,
    "col": 14
   },
   {
    "number": 9,
    "text": "Er í rónni með einhvers konar raus og þvælu út af plöntu.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 0,
    "col": 16
   },
   {
    "number": 10,
    "text": "Ani af brautarteini út af hlíf.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 0,
    "col": 19
   },
   {
    "number": 19,
    "text": "Nær Inga ref og enn einum til. Þannig fær hún orkugjafa.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 8,
    "col": 17
   },
   {
    "number": 20,
    "text": "Hræðir fleiri alltaf með einu stóru svæði.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 0
   },
   {
    "number": 21,
    "text": "Útskýrðu þið að tæplega fimmtíu væru borðanleg þrátt fyrir röfl.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 3
   },
   {
    "number": 22,
    "text": "Fer í bandaríska þungarokkshljómsveit með stór tól til að sjá hásæti.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 5
   },
   {
    "number": 23,
    "text": "Verðmætt efni eða stórt og miðlungs tré.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 7
   },
   {
    "number": 24,
    "text": "Það sem er gert í lyfjafyrirtækjum og er líka gert í framhalds- og háskólum.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 9
   },
   {
    "number": 25,
    "text": "Iðrast með ópi að fá málm í veikindunum.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 11
   },
   {
    "number": 27,
    "text": "Mar sem ellefu stinn fá frá þeim vinstri sinnaða.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 19
   },
   {
    "number": 30,
    "text": "Ásamt bindissamtökum eru fleiri en einn með veiði.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 12,
    "col": 15
   }
  ]
 },
