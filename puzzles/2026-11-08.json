 "clues": {
  "across": [
   {
    "number": 1,
    "text": "\u0007Hræðilegt slys sem byggir á mansali.",
    "enumeration": "4,5,3",
    "answer_length": 12,
    "row": 0,
    "col": 0
   },
   {
    "number": 6,
    "text": "\u0007Sé afa Elsu ruglast en vera samt öruggur.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 0,
    "col": 13
   },
   {
    "number": 10,
    "text": "\u0007Flott, í Uppsölum eru alltaf lyf.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 2,
    "col": 0
   },
   {
    "number": 11,
    "text": "\u0007Að lykta næstum nóg í látum.",
    "enumeration": "6",
    "answer_length": 6,
    "row": 2,
    "col": 14
   },
   {
    "number": 12,
    "text": "\u0007Dýrka marðardýr lamaðar?",
    "enumeration": "10",
    "answer_length": 10,
    "row": 4,
    "col": 10
   },
   {
    "number": 14,
    "text": "\u0007Jarm, tuð og rugl um plöntu.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 5,
    "col": 2
   },
   {
    "number": 15,
    "text": "\u0007Arinn fellur foreldri sem er í fátæktinni.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 6,
    "col": 10
   },
   {
    "number": 16,
    "text": "\u0007Hafðir tvisvar kraft til að lyfta bæjum sem voru tveggja hæða.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 7,
    "col": 0
   },
   {
    "number": 18,
    "text": "\u0007Fyrir utan fimm aðra ert þú með það ytra.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 8,
    "col": 12
   },
   {
    "number": 19,
    "text": "\u0007Heilagt orð um land.",
    "enumeration": "5",
    "answer_length": 5,
    "row": 9,
    "col": 0
   },
   {
    "number": 20,
    "text": "\u0007Hæ, fæ bjór fyrir raggeit.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 9,
    "col": 6
   },
   {
    "number": 21,
    "text": "\u0007Sorgleg yfirlýsing í spilum er kennsla.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 10,
    "col": 12
   },
   {
    "number": 23,
    "text": "\u0007Þeir sem eru norskastir eru líka elstir.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 11,
    "col": 0
   },
   {
    "number": 24,
    "text": "\u0007Inga er snyrtileg og hefur ósk og væntingar um fjármuni.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 12,
    "col": 10
   },
   {
    "number": 28,
    "text": "\u0007Við landræmu úr sandi voru fimm agnir hjá þeim sem passar að dýr séu ekki drepin.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 13,
    "col": 0
   },
   {
    "number": 30,
    "text": "\u0007Þótt þú fagnir með Landsbankanum eru örsmáar lífverur ekki langt undan.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 14,
    "col": 12
   },
   {
    "number": 33,
    "text": "\u0007Hestur sem þú flytur einfaldlega með er sérstakur útlits.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 16,
    "col": 0
   },
   {
    "number": 34,
    "text": "\u0007Hlusta á þrusu-mars og sé malinn hjá sveitapiltinum.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 17,
    "col": 8
   },
   {
    "number": 35,
    "text": "\u0007Vistvæn vinna er lituð.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 19,
    "col": 1
   },
   {
    "number": 36,
    "text": "\u0007Tóti ungur ruglast enn á líkamspartinum.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 19,
    "col": 10
   }
  ],
  "down": [
   {
    "number": 1,
    "text": "\u0007Sóist út af þurri list.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 0,
    "col": 0
   },
   {
    "number": 2,
    "text": "\u0007Erum með strípaðar úlpur þegar við rænum einhvern veginn.",
    "enumeration": "6",
    "answer_length": 6,
    "row": 0,
    "col": 2
   },
   {
    "number": 3,
    "text": "\u0007Iðgjöldin fyrir orma eru það sem glæpamaður getur fengið.",
    "enumeration": "14",
    "answer_length": 14,
    "row": 0,
    "col": 4
   },
   {
    "number": 4,
    "text": "\u0007Meiri jurtalitur missir einn í beði.",
    "enumeration": "14",
    "answer_length": 14,
    "row": 0,
    "col": 7
   },
   {
    "number": 5,
    "text": "\u0007Hægri hönd í stjórnmálaflokki?",
    "enumeration": "11",
    "answer_length": 11,
    "row": 0,
    "col": 10
   },
   {
    "number": 7,
    "text": "\u0007Kinn sem er á mörkunum fyrir Ólaf er á fuglinum.",
    "enumeration": "13",
    "answer_length": 13,
    "row": 0,
    "col": 14
   },
   {
    "number": 8,
    "text": "\u0007Læt ál og natríum fyrir nikkel frá þessum sem deilir einhverju með mér.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 0,
    "col": 17
   },
   {
    "number": 9,
    "text": "\u0007Snótin fær T-peninga úr kvíanetunum.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 0,
    "col": 19
   },
   {
    "number": 13,
    "text": "\u0007Kindaafurð Bandaríkjamanns er bara hrærigrautur.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 4,
    "col": 12
   },
   {
    "number": 17,
    "text": "\u0007Með ís og slit verður rófið að efnafræðihugtakinu.",
    "enumeration": "13",
    "answer_length": 13,
    "row": 7,
    "col": 2
   },
   {
    "number": 19,
    "text": "\u0007Rita: „Flaggið og meiðslin af því.“",
    "enumeration": "10",
    "answer_length": 10,
    "row": 9,
    "col": 0
   },
   {
    "number": 22,
    "text": "\u0007Þótt ég missi von er samt hægt að sjá lítinn vin í G-list.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 17
   },
   {
    "number": 24,
    "text": "\u0007Stórtemplarinn missir eitt narsl í form.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 12,
    "col": 10
   },
   {
    "number": 25,
    "text": "\u0007Huldufólkspílan er enn það sem veldur merkjunum á líkamanum.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 12,
    "col": 12
   },
   {
    "number": 26,
    "text": "\u0007Er einhvern veginn argsamur yfir skordýri.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 12,
    "col": 15
   },
   {
    "number": 27,
    "text": "\u0007Hann snýr æ inn á annan hátt út af sjónvandanum.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 12,
    "col": 19
   },
   {
    "number": 29,
    "text": "\u0007Óttar fljótfær hittir skaddaðar.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 13,
    "col": 6
   },
   {
    "number": 31,
    "text": "\u0007Hálfgert kjaftæði hjá íþróttafélagi fjallar um dýr.",
    "enumeration": "5",
    "answer_length": 5,
    "row": 15,
    "col": 4
   },
   {
    "number": 32,
    "text": "\u0007Larsen nær í eitur.",
    "enumeration": "5",
    "answer_length": 5,
    "row": 15,
    "col": 8
   }
  ]
 }
}
