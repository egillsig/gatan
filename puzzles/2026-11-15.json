 "clues": {
  "across": [
   {
    "number": 1,
    "text": "\u0007Griffinn tapar óþekktum en fær hundrað í tveimur lotum fyrir skriffæri.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 0,
    "col": 1
   },
   {
    "number": 6,
    "text": "\u0007Dæsum: „Sé mal úr gulli sem er einstakur.“",
    "enumeration": "8",
    "answer_length": 8,
    "row": 0,
    "col": 12
   },
   {
    "number": 10,
    "text": "\u0007Hey, Maslow er sagður vera aftur við handrið á svæðum sem þú þekkir vel.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 2,
    "col": 0
   },
   {
    "number": 11,
    "text": "\u0007Spjaldið til að byrgja með er það sem er búið áður en elli kemur.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 3,
    "col": 10
   },
   {
    "number": 12,
    "text": "\u0007Fara mín út í UV ljós þegar Íris ruglast á armi?",
    "enumeration": "11",
    "answer_length": 11,
    "row": 5,
    "col": 0
   },
   {
    "number": 13,
    "text": "\u0007Tek barnskepnu úr sameignarbúskapnum út af pissi.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 5,
    "col": 12
   },
   {
    "number": 14,
    "text": "\u0007Sænskur og gylltur er málmurinn.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 7,
    "col": 0
   },
   {
    "number": 16,
    "text": "\u0007Áttu enn glansmynd af fugli?",
    "enumeration": "8",
    "answer_length": 8,
    "row": 7,
    "col": 10
   },
   {
    "number": 17,
    "text": "\u0007Aðgerð sem felst í því að setja nýjan stoðvef í stað gamals finnst í sumum bílum.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 9,
    "col": 8
   },
   {
    "number": 20,
    "text": "\u0007Gas sem kemur aftur út af viðardufti.",
    "enumeration": "3",
    "answer_length": 3,
    "row": 10,
    "col": 4
   },
   {
    "number": 21,
    "text": "\u0007Ég sé hvort Filip fálmi einhvern veginn.",
    "enumeration": "5",
    "answer_length": 5,
    "row": 11,
    "col": 0
   },
   {
    "number": 22,
    "text": "\u0007Þorp sem er alltaf að hrósa áfengi?",
    "enumeration": "12",
    "answer_length": 12,
    "row": 11,
    "col": 8
   },
   {
    "number": 26,
    "text": "\u0007Frásögnin af smáræðinu.",
    "enumeration": "5",
    "answer_length": 5,
    "row": 13,
    "col": 0
   },
   {
    "number": 27,
    "text": "\u0007Skyggni maðurinn rukkar með peningunum.",
    "enumeration": "14",
    "answer_length": 14,
    "row": 13,
    "col": 6
   },
   {
    "number": 28,
    "text": "\u0007Ó, spurning um upphaf ökutíma fyrir órólega.",
    "enumeration": "5",
    "answer_length": 5,
    "row": 15,
    "col": 2
   },
   {
    "number": 29,
    "text": "\u0007S og S grænmeti í sérstakri festingu.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 15,
    "col": 13
   },
   {
    "number": 30,
    "text": "\u0007Þannig æddum við og borðuðum.",
    "enumeration": "6",
    "answer_length": 6,
    "row": 16,
    "col": 8
   },
   {
    "number": 31,
    "text": "\u0007Sé fugl við að gagga einhvern veginn um ramma.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 17,
    "col": 0
   },
   {
    "number": 32,
    "text": "\u0007Stífnin hjá karlmanni veldur byltingunni.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 18,
    "col": 10
   },
   {
    "number": 33,
    "text": "\u0007Er egypskur guð uns, æi, bókmenntastefna birtist.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 19,
    "col": 0
   }
  ],
  "down": [
   {
    "number": 2,
    "text": "\u0007Planta gerð úr lúrfiskum.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 0,
    "col": 3
   },
   {
    "number": 3,
    "text": "\u0007Silfurskál missir ál og er bara með lélegri afurðir en hann.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 0,
    "col": 5
   },
   {
    "number": 4,
    "text": "\u0007Nagdýrið í hópnum er það sem flýtur um í liðholinu.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 0,
    "col": 8
   },
   {
    "number": 5,
    "text": "\u0007Sá sem er spillandi kemur gefandi skít.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 0,
    "col": 10
   },
   {
    "number": 6,
    "text": "\u0007Erlend ídýfa fugla og Týs er einfaldlega í íláti. Þessi vísbending er fyrir þá sem eru liprari í samskiptum.",
    "enumeration": "14",
    "answer_length": 14,
    "row": 0,
    "col": 12
   },
   {
    "number": 7,
    "text": "\u0007Agla er að tuða um einhvers konar reipi.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 0,
    "col": 15
   },
   {
    "number": 8,
    "text": "\u0007Afsakið rif sem ég gerði einhvern veginn ekki ráð fyrir.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 0,
    "col": 17
   },
   {
    "number": 9,
    "text": "\u0007Berg með sér bjarma ber.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 0,
    "col": 19
   },
   {
    "number": 10,
    "text": "\u0007Hjó með fánýti.",
    "enumeration": "4",
    "answer_length": 4,
    "row": 2,
    "col": 0
   },
   {
    "number": 14,
    "text": "\u0007Ég sjálf hjá Söru Ragg hitti aftur upplitsdjarfar.",
    "enumeration": "13",
    "answer_length": 13,
    "row": 7,
    "col": 0
   },
   {
    "number": 15,
    "text": "\u0007Í byrjun bókar er alltaf hrúga af einni fönn sem þú gengur inn um.",
    "enumeration": "13",
    "answer_length": 13,
    "row": 7,
    "col": 6
   },
   {
    "number": 17,
    "text": "\u0007Dekka kaffiborð og hugsa um leið.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 9,
    "col": 8
   },
   {
    "number": 18,
    "text": "\u0007Gerðir við ljósaperu fyrir þá sem eru breiðari að neðan.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 9,
    "col": 15
   },
   {
    "number": 19,
    "text": "\u0007Spóluðu í kringum innihald strangans og gáfu frá sér sérstök hljóð.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 2
   },
   {
    "number": 20,
    "text": "\u0007Prump eftir að hafa borðað mulin fræ er lífshættulegt.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 4
   },
   {
    "number": 23,
    "text": "\u0007Sýna tvö D-dæmi um ekkert sem urðu til þess að forn Færeyingur birtist hér aftur.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 11,
    "col": 10
   },
   {
    "number": 24,
    "text": "\u0007Herklæði fyrir vanga eru sögð vera á hólnum.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 11,
    "col": 17
   },
   {
    "number": 25,
    "text": "\u0007Trjónuhnökrinn sést á köngulónni.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 11,
    "col": 19
   },
   {
    "number": 29,
    "text": "\u0007Flottur sirkus?",
    "enumeration": "5",
    "answer_length": 5,
    "row": 15,
    "col": 13
   }
  ]
 }
}
