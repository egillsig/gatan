 "clues": {
  "across": [
   {
    "number": 1,
    "text": "Álíka verkur eins og mjúk fær í iður sín sést hjá persónunum.",
    "enumeration": "16",
    "answer_length": 16,
    "row": 0,
    "col": 0
   },
   {
    "number": 7,
    "text": "Vertu diplómatískur og taktu ríkjandi venjur.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 2,
    "col": 0
   },
   {
    "number": 9,
    "text": "Bráðlynd hoppaði.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 2,
    "col": 10
   },
   {
    "number": 12,
    "text": "Þú kemur aftur á sérstakan hátt til að aga beitilyng þannig að skepnur hafi aðgengi að mat.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 4,
    "col": 6
   },
   {
    "number": 13,
    "text": "Hlýr með eitt kíló. Það er ljóðræna.",
    "enumeration": "5",
    "answer_length": 5,
    "row": 5,
    "col": 0
   },
   {
    "number": 14,
    "text": "Lætur ekki sjó gufa upp og þéttast.",
    "enumeration": "5",
    "answer_length": 5,
    "row": 5,
    "col": 15
   },
   {
    "number": 15,
    "text": "Rut, sauðarleg, ruglast á fúsum.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 7,
    "col": 0
   },
   {
    "number": 17,
    "text": "Þú, Færeyingur, lendir hjá Tomma til að fá nagla.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 7,
    "col": 13
   },
   {
    "number": 19,
    "text": "Forritunin góða skapar slæma tilfinningu.",
    "enumeration": "14",
    "answer_length": 14,
    "row": 9,
    "col": 5
   },
   {
    "number": 23,
    "text": "Ég vil alltaf kúgun síðustu ár mín.",
    "enumeration": "6",
    "answer_length": 6,
    "row": 10,
    "col": 0
   },
   {
    "number": 26,
    "text": "Athugaðu laupinn að mestu í árásunum.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 11,
    "col": 11
   },
   {
    "number": 28,
    "text": "Duttu af stultunum.",
    "enumeration": "4",
    "answer_length": 4,
    "row": 12,
    "col": 0
   },
   {
    "number": 29,
    "text": "Kona, þegiðu yfir munnvatnsúða.",
    "enumeration": "5",
    "answer_length": 5,
    "row": 12,
    "col": 7
   },
   {
    "number": 31,
    "text": "Fúl yfir hluta úr grömmum.",
    "enumeration": "4",
    "answer_length": 4,
    "row": 14,
    "col": 0
   },
   {
    "number": 32,
    "text": "Bútaði niður fjölda rússneskra.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 14,
    "col": 5
   },
   {
    "number": 33,
    "text": "Lovísa bætir á sig með rabarbara frá því fáfróðara.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 14,
    "col": 13
   },
   {
    "number": 34,
    "text": "Amma fær krónu og sú pannan sem hún tekur inniheldur réttinn.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 16,
    "col": 0
   },
   {
    "number": 35,
    "text": "Glatkista missir einn ask til þess sem er ánægt.",
    "enumeration": "5",
    "answer_length": 5,
    "row": 17,
    "col": 11
   },
   {
    "number": 36,
    "text": "Trúarhrifning sem hin eru ekki með í hentar ákveðnum konum.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 19,
    "col": 0
   },
   {
    "number": 37,
    "text": "Hestakonuna bar ég frá kennaraborði.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 19,
    "col": 11
   }
  ],
  "down": [
   {
    "number": 1,
    "text": "Eftir að ég fer til baka til að sinna gæslu.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 0,
    "col": 0
   },
   {
    "number": 2,
    "text": "Það er keyrt með innleggi á Twitter sem hefur verið sett tvisvar inn.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 0,
    "col": 4
   },
   {
    "number": 3,
    "text": "Sé skít hjá Lúxemborg og við klukku er æðibunugangur hjá hatursfullum samtökum.",
    "enumeration": "2,4,4",
    "answer_length": 10,
    "row": 0,
    "col": 6
   },
   {
    "number": 4,
    "text": "Ég iðrast þess með gylltum manni að vera heilbrigð hvað varðar meltingu.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 0,
    "col": 8
   },
   {
    "number": 5,
    "text": "Hamingja sem ég hálfvegis aum næ að skoða vel.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 0,
    "col": 10
   },
   {
    "number": 6,
    "text": "Næ til Unu, söngkonu, stjörnu erlendis, og sýni henni þær sem eru mjög ofarlega.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 0,
    "col": 13
   },
   {
    "number": 8,
    "text": "Þótt klukka komi úr spili þá er samt dónaskapur til staðar.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 2,
    "col": 2
   },
   {
    "number": 10,
    "text": "Ég tölti einhvern veginn ein í partíin.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 2,
    "col": 15
   },
   {
    "number": 11,
    "text": "Sá sem er ekki langvarandi segir: „Svei þér, kind.“",
    "enumeration": "7",
    "answer_length": 7,
    "row": 3,
    "col": 18
   },
   {
    "number": 16,
    "text": "Vefjast vitlausar utan um nýfætt barn.",
    "enumeration": "13",
    "answer_length": 13,
    "row": 7,
    "col": 11
   },
   {
    "number": 18,
    "text": "Hann er ætur og með hálfbilað spírað byggkorn sem er nú frekar nýtt.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 9,
    "col": 0
   },
   {
    "number": 19,
    "text": "Keyrði Jörgen Garúnu til þeirra sem mega ekki bjóða fram?",
    "enumeration": "11",
    "answer_length": 11,
    "row": 9,
    "col": 5
   },
   {
    "number": 20,
    "text": "Orð fæ fyrir sjávarstrauma frá þeim mælskustu.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 9,
    "col": 7
   },
   {
    "number": 21,
    "text": "Fikt við purpura getur endað sem breyting til hins verra.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 9,
    "col": 9
   },
   {
    "number": 22,
    "text": "Áfengið fyrir framagosa og umsjónarmann barna.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 9,
    "col": 17
   },
   {
    "number": 24,
    "text": "Á laugardag er nanómetrinn næstum orðinn hluti af glæpunum.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 3
   },
   {
    "number": 25,
    "text": "En gjald er næstum án eins og er enn vegna samninganna um afnot af sláttulandi.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 19
   },
   {
    "number": 27,
    "text": "Héri fær mikinn ótta við að sjá þann sem er meira gráýróttur.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 11,
    "col": 13
   },
   {
    "number": 30,
    "text": "Síð kemur aftur til Kötu með stingi á hliðunum.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 13,
    "col": 15
   }
  ]
 }
}
