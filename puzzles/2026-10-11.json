 "clues": {
  "across": [
   {
    "number": 1,
    "text": "\u0007Hin danska móðir Móna er sögð syngja í helgidómi.",
    "enumeration": "13",
    "answer_length": 13,
    "row": 0,
    "col": 0
   },
   {
    "number": 7,
    "text": "\u0007Hallarryk hættir að sjást.",
    "enumeration": "6",
    "answer_length": 6,
    "row": 0,
    "col": 14
   },
   {
    "number": 10,
    "text": "\u0007Lassi er með í fermetra sem sýnir heildarþunga lífvera.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 2,
    "col": 0
   },
   {
    "number": 11,
    "text": "\u0007Nef, næstu daga, er aftur frat og Samtök atvinnulífsins eru í vinnu.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 2,
    "col": 9
   },
   {
    "number": 12,
    "text": "\u0007Frjálsíþróttakeppni með litlum boltum sem reynir á axlarlið og mjaðmarlið?",
    "enumeration": "11",
    "answer_length": 11,
    "row": 4,
    "col": 0
   },
   {
    "number": 13,
    "text": "\u0007Stakk bara þann síðasta einhvern veginn af í fimleikaæfingu.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 5,
    "col": 10
   },
   {
    "number": 14,
    "text": "\u0007Fjall Inga leiðir okkur að úreltri lánastofnun og klæði.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 6,
    "col": 0
   },
   {
    "number": 16,
    "text": "\u0007Mistök sem eru lofuð í lofsöng.",
    "enumeration": "6",
    "answer_length": 6,
    "row": 8,
    "col": 2
   },
   {
    "number": 17,
    "text": "\u0007Æði að giftri konu með mjólkurafurð í miklum kulda.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 8,
    "col": 10
   },
   {
    "number": 19,
    "text": "\u0007Breyti auðri erlendri stjörnu með raftækjum.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 10,
    "col": 1
   },
   {
    "number": 23,
    "text": "\u0007Ólöf fær einhvern veginn hug sinn aftur frá hafsvæðum.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 10,
    "col": 13
   },
   {
    "number": 25,
    "text": "\u0007Ósk barnabókapersónu sem var óþekk og óhirðusöm (þýð. Stefán Júlíusson) reynist vera formæling.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 12,
    "col": 0
   },
   {
    "number": 27,
    "text": "\u0007Púðakusk og ílát undir fiskvöðva.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 12,
    "col": 9
   },
   {
    "number": 28,
    "text": "\u0007Klassísk hryllingsmynd sem enn skaðar okkur mikið með óþverraskap sínum.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 14,
    "col": 0
   },
   {
    "number": 29,
    "text": "\u0007Trú sem andamaður hefur á Afríkubúa.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 14,
    "col": 9
   },
   {
    "number": 31,
    "text": "\u0007Háskaráð Glóa nægir til að fá titil.",
    "enumeration": "12",
    "answer_length": 12,
    "row": 16,
    "col": 0
   },
   {
    "number": 32,
    "text": "\u0007Sú hjá hesti sér öldugang.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 16,
    "col": 13
   },
   {
    "number": 34,
    "text": "\u0007Aldnir og Áki ná að hitta preláta.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 18,
    "col": 5
   },
   {
    "number": 35,
    "text": "\u0007Snú þeim fyrsta við til að fá þyngd hans.",
    "enumeration": "4",
    "answer_length": 4,
    "row": 19,
    "col": 2
   },
   {
    "number": 36,
    "text": "\u0007Sá sem er sannari eins og sagt er við Ara fróða.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 19,
    "col": 13
   }
  ],
  "down": [
   {
    "number": 1,
    "text": "\u0007Filma kofa og blanda drykk.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 0,
    "col": 0
   },
   {
    "number": 2,
    "text": "\u0007Ræ með franskan son þangað sem staðsetningar eru. Hann er tötralegur.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 0,
    "col": 2
   },
   {
    "number": 3,
    "text": "\u0007Í Nice að sögn dáir þú þær sem eru nýlega búnar að setja fót sinn niður.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 0,
    "col": 5
   },
   {
    "number": 4,
    "text": "\u0007Varaskeifa nær að kjaga.",
    "enumeration": "5",
    "answer_length": 5,
    "row": 0,
    "col": 7
   },
   {
    "number": 5,
    "text": "\u0007Sé Lettann ranglega fara í hálfgert geitakall á bergnös.",
    "enumeration": "11",
    "answer_length": 11,
    "row": 0,
    "col": 10
   },
   {
    "number": 6,
    "text": "\u0007Angur um snaga reynist bara vera heimska.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 0,
    "col": 12
   },
   {
    "number": 7,
    "text": "\u0007Tónleikahús þar sem eru alltaf átök um píanó?",
    "enumeration": "9",
    "answer_length": 9,
    "row": 0,
    "col": 14
   },
   {
    "number": 8,
    "text": "Í langflestum tilvikum fellur fólk ekki á prófum.",
    "enumeration": "6,3",
    "answer_length": 9,
    "row": 0,
    "col": 16
   },
   {
    "number": 9,
    "text": "\u0007Ofsóttu krónu með einhvers konar gæluyrði.",
    "enumeration": "9",
    "answer_length": 9,
    "row": 0,
    "col": 19
   },
   {
    "number": 15,
    "text": "\u0007Sé að gangur sem felur fæddan sé staður sem flestir koma inn um.",
    "enumeration": "13",
    "answer_length": 13,
    "row": 6,
    "col": 7
   },
   {
    "number": 18,
    "text": "\u0007Ef ég er með Rimmugýgi þá er ég örlát.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 8,
    "col": 15
   },
   {
    "number": 20,
    "text": "\u0007Ber áll nær að hitta jafn beran snákinn.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 3
   },
   {
    "number": 21,
    "text": "\u0007Kristína lá og gerðist ómerkilega manneskjan.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 9
   },
   {
    "number": 22,
    "text": "\u0007Form fyrir miðaldahermann endar skák.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 11
   },
   {
    "number": 23,
    "text": "\u0007Varatindós ruglast þá verst gerðu.",
    "enumeration": "10",
    "answer_length": 10,
    "row": 10,
    "col": 13
   },
   {
    "number": 24,
    "text": "\u0007Skítur yrði að loforði í þessu.",
    "enumeration": "7",
    "answer_length": 7,
    "row": 10,
    "col": 19
   },
   {
    "number": 25,
    "text": "\u0007Hó, tilbið einhvern veginn sterkar tilfinningar.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 12,
    "col": 0
   },
   {
    "number": 26,
    "text": "\u0007Lútur finnst einnig í kirkju.",
    "enumeration": "8",
    "answer_length": 8,
    "row": 12,
    "col": 5
   },
   {
    "number": 30,
    "text": "\u0007Steindir apa eftir títuprjónum.",
    "enumeration": "6",
    "answer_length": 6,
    "row": 14,
    "col": 16
   },
   {
    "number": 33,
    "text": "\u0007Dedúar og gengur upp og niður.",
    "enumeration": "4",
    "answer_length": 4,
    "row": 16,
    "col": 18
   }
  ]
 }
}
